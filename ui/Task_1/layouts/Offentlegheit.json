        "textResourceBindings": {
          "title": "Offentlegheit.title"
        }
      },
      {
        "id": "Offentlegheit-Intro",
        "type": "Paragraph",
        "textResourceBindings": {
          "title": "Offentlegheit.intro"
        }
      },
      {
        "id": "Offentlegheit-offentlegheit",
        "type": "RadioButtons",
        "textResourceBindings": {
